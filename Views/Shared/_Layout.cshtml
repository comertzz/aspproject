<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YolcuRent Araç Kiralama</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/aspproject.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Top info bar -->
    <div class="top-bar">
        <div class="top-bar-inner">
            <div class="top-bar-left">
                <span><i class="bi bi-shield-check text-success"></i> Güvenli & Kaskolu Araç Kiralama</span>
                <span class="d-none d-md-inline ms-3"><i class="bi bi-geo-alt-fill text-danger"></i> Havalimanı & Şehir Merkezi Teslimat</span>
            </div>
            <div class="top-bar-right">
                <a href="tel:08501234567"><i class="bi bi-telephone-fill"></i> 7/24 Destek: <strong>0850 123 45 67</strong></a>
            </div>
        </div>
    </div>

    <!-- Main Navigation -->
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-fluid site-nav-container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-badge"><i class="bi bi-car-front-fill"></i></span>
                    <span class="brand-text">Yolcu<span>Rent</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Menüyü Aç/Kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-grid-fill me-1"></i> Araç Filosu
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-file-earmark-text-fill me-1"></i> Kiralama Koşulları & SSS
                            </a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center gap-2">
                        <a class="btn btn-outline-secondary lookup-nav-btn" asp-controller="Booking" asp-action="Lookup">
                            <i class="bi bi-ticket-perforated-fill text-primary"></i> Rezervasyon Sorgula
                        </a>
                        <a class="btn btn-primary d-none d-sm-inline-block" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-lightning-fill"></i> Hızlı Araç Bul
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <!-- Site Footer -->
    <footer class="site-footer">
        <div class="footer-container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="footer-brand">
                        <span class="brand-badge"><i class="bi bi-car-front-fill"></i></span>
                        <span class="brand-text text-white">Yolcu<span>Rent</span></span>
                    </div>
                    <p class="footer-desc mt-3">
                        Türkiye genelinde havalimanı ve şehir içi teslim noktalarıyla, şeffaf fiyat politikası ve güvenilir filo hizmeti sunuyoruz.
                    </p>
                    <div class="footer-badges">
                        <span><i class="bi bi-shield-lock-fill text-success"></i> 256-Bit SSL</span>
                        <span><i class="bi bi-credit-card-2-back text-primary"></i> Güvenli Ödeme</span>
                        <span><i class="bi bi-check-all text-warning"></i> %100 Kasko</span>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-title">Hızlı Bağlantılar</h5>
                    <ul class="footer-links">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right"></i> Müsait Araçlar</a></li>
                        <li><a asp-controller="Booking" asp-action="Lookup"><i class="bi bi-chevron-right"></i> Rezervasyon Sorgula</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy"><i class="bi bi-chevron-right"></i> Kiralama Şartları</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy"><i class="bi bi-chevron-right"></i> İptal Politikası</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title">Teslimat Lokasyonları</h5>
                    <ul class="footer-links">
                        <li><a href="#"><i class="bi bi-geo-alt-fill text-danger"></i> İstanbul Havalimanı (IST)</a></li>
                        <li><a href="#"><i class="bi bi-geo-alt-fill text-danger"></i> Sabiha Gökçen Havalimanı (SAW)</a></li>
                        <li><a href="#"><i class="bi bi-geo-alt-fill text-danger"></i> Ankara Esenboğa & Merkez</a></li>
                        <li><a href="#"><i class="bi bi-geo-alt-fill text-danger"></i> İzmir Adnan Menderes & Alsancak</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-title">İletişim & Destek</h5>
                    <div class="footer-contact">
                        <p><i class="bi bi-telephone-fill text-primary"></i> <strong>0850 123 45 67</strong></p>
                        <p><i class="bi bi-envelope-fill text-warning"></i> destek@yolcurent.com</p>
                        <p><i class="bi bi-clock-fill text-info"></i> 7 Gün 24 Saat Kesintisiz Hizmet</p>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year YolcuRent Araç Kiralama A.Ş. Tüm hakları saklıdır.</p>
                <div class="footer-bottom-links">
                    <a asp-controller="Home" asp-action="Privacy">Gizlilik ve Çerez Politikası</a>
                    <a asp-controller="Home" asp-action="Privacy">Kullanım Şartları</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
